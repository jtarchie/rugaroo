    @x = x
  end
end
p P.new(1).x
-- ivar_write.rb --
# error: main.rb:3: P is marked # @value but bump writes an instance variable (line 11)
# @value
class P
  #: (Integer x) -> void
  def initialize(x)
    @x = x
  end

  #: () -> void
  def bump
    @x += 1
  end
end
P.new(1).bump
