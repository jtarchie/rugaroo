Compile errors and warnings for Array, Enumerable, tuples, splats and blocks over collections.
-- return_in_closure.rb --
# error: main.rb:4: non-local return from a block is not supported (docs/design.md decision 4)
#: (Array[Integer]) -> Integer
def f(nums)
  nums.map { |n| return n }
  0
end
puts f([1])
-- break_in_closure.rb --
# error: main.rb:3: break inside a non-iterator block is not supported
nums = [1, 2] #: Array[Integer]
puts nums.map { |n| break }.inspect
-- break_with_value.rb --
# error: main.rb:3: break with a value is not supported
nums = [1, 2] #: Array[Integer]
nums.each { |n| break n }
-- next_with_value_in_iterator.rb --
# error: main.rb:3: next with a value is not supported
nums = [1, 2] #: Array[Integer]
nums.each { |n| next n }
-- block_to_blockless_method.rb --
# error: main.rb:3: size does not take a block
nums = [1, 2] #: Array[Integer]
puts nums.size { |n| n }
-- overload_signature.rb --
# error: main.rb:4: overloaded signatures (#|) are not supported
#: (Integer) -> Integer
#| (String) -> String
def ident(x) = x
puts ident(1)
-- splat_of_non_array.rb --
# error: main.rb:4: splat of non-array Integer
#: (*Integer) -> Integer
def total(*ns) = ns.size
puts total(*5)
-- splat_of_tuple.rb --
# error: main.rb:5: splat of non-array [Integer, String]
#: (*Integer) -> Integer
def total(*ns) = ns.size
pair = [1, "a"]
puts total(*pair)
-- splat_into_positional_needs_array.rb --
# error: main.rb:4: splat of Hash[Symbol, Integer] into a non-rest parameter: only an Array is supported
#: (Integer, Integer) -> Integer
def add(a, b) = a + b
puts add(*{a: 1})
-- rest_in_sig_not_def.rb --
# error: main.rb:3: signature has a rest param but def does not
#: (*Integer) -> Integer
def total(ns) = ns.size
puts total(1)
-- rest_in_def_not_sig.rb --
# error: main.rb:3: signature has 1 positional params but def has 0
#: (Integer) -> Integer
def total(*ns) = ns.size
puts total(1)
-- block_tuple_arity.rb --
# error: main.rb:3: block takes 3 params but the tuple has 2 elements
pairs = [[1, "a"]] #: Array[[Integer, String]]
pairs.each { |n, s, extra| puts n }
-- block_too_many_params.rb --
# error: main.rb:3: block takes 2 params but only 1 values are yielded
nums = [1, 2] #: Array[Integer]
nums.each { |a, b| puts a }
-- block_arg_proc.rb --
# warning: main.rb:2: a lambda's parameters are untyped
up = proc { |s| s.upcase }
puts up.arity
-- block_returns_non_array.rb --
# error: main.rb:3: block returns Integer, expected Array[U]
nums = [1, 2] #: Array[Integer]
puts nums.flat_map { |n| n }.inspect
-- yield_without_block_sig.rb --
# error: main.rb:4: yield in a method whose signature has no block
#: () -> void
def each_one
  yield 1
end
each_one { |x| puts x }
-- yield_arity.rb --
# error: main.rb:4: yield passes 2 values but the block takes 1
#: () { (Integer) -> void } -> void
def each_one
  yield 1, 2
end
each_one { |x| puts x }
-- block_param_stored.rb --
# error: main.rb:5: the block parameter &block can only be called (block.call) or passed on (&block)
class Keeper
  #: () { (Integer) -> void } -> void
  def keep(&block)
    @saved = block
  end
end
-- block_param_without_block_sig.rb --
# error: main.rb:3: a &block parameter needs a block in the signature
#: () -> void
def run(&block)
  block.call
end
run { puts 1 }
-- forwarded_block_arity.rb --
# error: main.rb:3: the forwarded block takes 2 values but 1 are yielded
#: () { (Integer, Integer) -> void } -> void
def each_pair(&block) = [1, 2].each(&block)
each_pair { |a, b| puts a }
-- forwarded_iterator_block_to_closure.rb --
# error: main.rb:5: this method's block is an iterator (it yields); it can only be passed on to another iterator
#: () { (Integer) -> void } -> void
def each_mapped(&block)
  yield 1
  [1].map(&block)
end
each_mapped { |x| puts x }
-- include_enumerable_without_type.rb --
# error: main.rb:3: include Enumerable needs 1 type args (`include Enumerable #[...]`): Box#each does not yield 1 values to infer them from
class Box
  include Enumerable

  #: () { (Integer, Integer) -> void } -> void
  def each
    yield 1, 2
  end
end
puts Box.new.to_a.inspect
-- cannot_infer_type_param.rb --
# error: main.rb:6: cannot infer type parameter T of Util.none
class Util
  #: [T] () -> Array[T]
  def self.none = []
end
puts Util.none.inspect
-- tuple_index_variable.rb --
# error: main.rb:4: tuple index must be a literal in range
pair = [1, "a"]
i = 0
puts pair[i].inspect
-- tuple_index_out_of_range.rb --
# error: main.rb:3: tuple index must be a literal in range
pair = [1, "a"]
puts pair[2].inspect
-- tuple_too_many_targets.rb --
# error: main.rb:4: 3 targets for a 2-tuple
#: () -> [Integer, String]
def pair = [1, "a"]
a, b, c = pair
puts a, b, c
-- tuple_eight_elements.rb --
# error: main.rb:3: only 2- to 7-tuples are supported
#: () -> [Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer]
def eight = [1, 2, 3, 4, 5, 6, 7, 8]
puts eight.inspect
-- multi_assign_nil.rb --
# error: main.rb:2: cannot infer a type from nil; annotate the target first
a, b = 1, nil
puts a, b
-- empty_literal_branch.rb --
# error: main.rb:3: branches have incompatible types Array[Integer] and Array[untyped]
nums = [1, -2] #: Array[Integer]
puts nums.flat_map { |n| n > 0 ? [n] : [] }.inspect
-- element_possibly_nil.rb --
# error: main.rb:3: possibly-nil Integer? where Integer is expected; check it first
nums = [1, 2] #: Array[Integer]
puts 1 + nums[0]
-- element_method_warns.rb --
# warning: main.rb:3: succ called on possibly-nil Integer (raises NoMethodError on nil)
nums = [1, 2] #: Array[Integer]
puts nums[0].succ
-- empty_literal_is_untyped.rb --
# warning: main.rb:5: dynamic call: succ on untyped
a = []
a << 1
a << "x"
puts a[0].succ
-- mixed_literal_is_untyped.rb --
# warning: main.rb:3: dynamic call: succ on untyped
row = [1, "a", :b, 2.5]
puts row[0].succ
-- push_wrong_element_type.rb --
# error: main.rb:3:
nums = [1, 2] #: Array[Integer]
nums << "x"
-- tuple_wrong_element_type.rb --
# error: main.rb:3:
pairs = [[1, "a"]] #: Array[[Integer, String]]
pairs << [2, 3]
-- block_returns_non_bool.rb --
# error: main.rb:3:
nums = [1, 2] #: Array[Integer]
puts nums.select { |n| n.to_s }.inspect
-- block_on_untyped.rb --
# error: main.rb:3: blocks on untyped receivers are not supported
u = [1] #: untyped
u.each { |x| puts x }
-- block_on_optional_untyped.rb --
# error: main.rb:3:
u = [[1]] #: Array[untyped]
u[0].each { |x| puts x }
-- super_to_block_method.rb --
# error: main.rb:11: super from an iterator (its block returns void) is not supported
class A
  #: () { (Integer) -> void } -> void
  def each
    yield 1
  end
end

class B < A
  def each
    super
  end
end
-- forwarded_block_passed_arity.rb --
# error: main.rb:3: the forwarded block takes 2 values but 1 are passed
#: () { (Integer, Integer) -> Integer } -> Array[Integer]
def pairs(&block) = [1, 2].map(&block)
puts pairs { |a, b| a + b }.inspect
-- rest_with_post.rb --
# error: main.rb:3: signature has 1 positional params but def has 2
#: (Integer, *Integer) -> Integer
def total(a, *rest, b) = a + b + rest.size
puts total(1, 2)
-- rest_in_def_not_sig_no_params.rb --
# error: main.rb:3: def has a rest param but signature does not
#: () -> Integer
def total(*ns) = ns.size
puts total
-- tuple_negative_index.rb --
# error: main.rb:3: tuple index must be a literal in range
pair = [1, "a"]
puts pair[-1].inspect
-- push_nil.rb --
# error: main.rb:3: nil where Integer is expected
nums = [1, 2] #: Array[Integer]
nums << nil
-- optional_array_method_warns.rb --
# warning: main.rb:3: size called on possibly-nil Array[Integer] (raises NoMethodError on nil)
h = { "a" => [1] } #: Hash[String, Array[Integer]]
puts h["a"].size
-- tuple_eq_no_args.rb --
# error: main.rb:3: Array#==: wrong number of arguments (given 0, expected 1)
t = [1, "a", :b]
p t.==()
-- inject_symbol_variable.rb --
# error: main.rb:3: inject(sym) needs a literal Symbol (`inject(:+)`) or a block
op = :+
p [1, 2, 3].inject(op)
