# Signatures for the parser gem (whitequark/parser 3.3), which ships none: the state of its Ragel-generated lexer.
# The lexer's position and state pass through lambdas held in ivars (`p = @num_xfrm.call(digits, p)`) and through
# LexerStrings and back, which inference leaves untyped (decision 466, "Not done"); every table lookup and comparison
# in `advance` is then a dynamic call. With these, the gem's own parse of 21 files runs 2,470M instructions instead
# of 7,945M. Each is what the gem assigns: a mismatch raises TypeError where it is stored.
# The buffer, its code points and LexerStrings' own state are here for a program whose caller hands the buffer over
# untyped (rubocop-ast's ProcessedSource): without them `pe`, `_trans` and every table lookup in both `advance`
# loops are dynamic there, and Ragel's 370-arm `case` is a chain of untyped comparisons (rubocop on 20 files:
# 13,982M -> 9,835M instructions, 2026-11-16).
module Parser
  class Lexer
    @source_buffer: Parser::Source::Buffer?
    @source_pts: Array[Integer]?
    @cs: Integer
    @p: Integer
    @ts: Integer?
    @te: Integer?
    @sharp_s: Integer?
    @newline_s: Integer?
    @num_base: Integer?
    @num_digits_s: Integer?
    @num_suffix_s: Integer?
    @eq_begin_s: Integer?
    @cs_before_block_comment: Integer
    @emit_integer: ^(untyped, Integer) -> Integer
    @emit_rational: ^(untyped, Integer) -> Integer
    @emit_imaginary: ^(untyped, Integer) -> Integer
    @emit_imaginary_rational: ^(untyped, Integer) -> Integer
    @emit_integer_re: ^(untyped, Integer) -> Integer
    @emit_integer_if: ^(untyped, Integer) -> Integer
    @emit_integer_rescue: ^(untyped, Integer) -> Integer
    @emit_float: ^(untyped, Integer) -> Integer
    @emit_imaginary_float: ^(untyped, Integer) -> Integer
    @emit_float_if: ^(untyped, Integer) -> Integer
    @emit_float_rescue: ^(untyped, Integer) -> Integer
    @num_xfrm: (^(untyped, Integer) -> Integer)?

    def on_newline: (Integer) -> Integer
    def stack_pop: () -> Integer
    def arg_or_cmdarg: (untyped) -> Integer
  end

  class LexerStrings
    @lexer: Parser::Lexer
    @cs: Integer
    @root_lexer_state: Integer
    @_lex_actions: Array[Integer]
    attr_accessor source_buffer: Parser::Source::Buffer?
    attr_accessor source_pts: Array[Integer]?

    def on_newline: (Integer) -> Integer
    def advance: (Integer) -> [Integer, Integer?]
  end

  module Source
    class Buffer
      # gem_rbs_collection's parser 3.2 says Encoding: an empty String, or one with no magic comment, answers nil
      def self.recognize_encoding: (String) -> Encoding?
    end
  end

  class Diagnostic
    class Engine
      # gem_rbs_collection's parser 3.2 types the consumer `^(Diagnostic) -> void`; callers store an untyped lambda
      # (rubocop-ast's `diagnostics.consumer = lambda { |diagnostic| ... }`), which is not a proc of that signature
      attr_accessor consumer: untyped
      def initialize: (?untyped consumer) -> void
    end
  end
end
