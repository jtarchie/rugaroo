# Corrections to snails-core's .rbs sidecars, where the Ruby can be nil and the sig says it cannot (nil_default_audit.rb finds the defaults).
module ActionController
  class API
    def render: (?String? body, ?status: Symbol | Integer, ?content_type: String?, ?location: String?, ?json: untyped) -> void
  end
end

module ActionDispatch
  class Request
    def initialize: (?Hash[String, untyped]? env) -> void
  end
end

module Sqlx
  module Query
    def find_by: (Hash[Symbol, untyped] conditions, ?order: Symbol?) -> untyped
    def fetch_many: (Hash[Symbol, untyped]? conditions, ?order: Symbol?, ?limit: Integer?, ?offset: Integer?) -> Array[untyped]
  end
end

# A thread-local read is nil before its first write.
module Snails
  class Logger
    module Context
      def self.controller: () -> String?
      def self.action: () -> String?
      def self.format: () -> String?
    end
  end
end
