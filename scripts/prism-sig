#!/usr/bin/env ruby
# frozen_string_literal: true

# Writes vendored/prism/sig/0_rugaroo.rbs, rugaroo's patches to the prism gem's shipped sig/ (decision 427): serialize.rb passes
# each node's locations packed into an Integer unless `freeze:`, and the node's reader unpacks it on first use, so every
# Location an initialize takes is `Location | Integer`, and each reader the sig calls an attr_reader is a def answering
# the Location. Run after scripts/vendor-prism.
root = File.expand_path("..", __dir__)
src = File.read(File.join(root, "vendored/prism/sig/prism/node.rbs"))
serialize = File.read(File.join(root, "vendored/prism/lib/prism/serialize.rb"))
version = %w[MAJOR MINOR PATCH].map { |k| serialize[/#{k}_VERSION = (\d+)/, 1] }.join(".")
out = +<<~RBS
  # Generated by scripts/prism-sig from prism #{version}'s sig/prism/node.rbs: rugaroo's patches to the shipped sig
  # (decision 427), first in the gem's sig/ walk, so they win per member (decision 306). Do not edit.
  module Prism
    class Node
      @location: Location | Integer
      def location: () -> Location
    end
RBS
src.scan(/^  class (\w+) < Node\n((?:(?!^  class ).*\n)*)/) do |cls, body|
  init = body[/^    (def initialize: .*)$/, 1] or next
  init = init.gsub(/\bLocation\? (\w+)/, '(Location | Integer)? \1').gsub(/\bLocation (\w+)/, '(Location | Integer) \1')
  readers = body.scan(/^    attr_reader (\w+_loc): (Location\??)$/).map { |name, type| "\n    def #{name}: () -> #{type}" }
  out << "\n  class #{cls} < Node\n    #{init}#{readers.join}\n  end\n"
end
out << <<~RBS

    module Serialize
      class Loader
        def load_node: (ConstantPool constant_pool, Encoding encoding, bool freeze) -> Node
      end
    end
  end
RBS
File.write(File.join(root, "vendored/prism/sig/0_rugaroo.rbs"), out)
